---
import { url } from '../lib/url.js';

const socials = [
  { label: 'Instagram', icon: url('/icons/instagram.svg'), href: 'https://www.instagram.com/xperiencethextraordinary' },
  { label: 'Facebook', icon: url('/icons/facebook.svg'), href: 'https://www.facebook.com/people/XperiencetheXtraordinary-travels/61575446506513/' },
  { label: 'Twitter', icon: url('/icons/linkedin.svg'), href: 'https://www.linkedin.com/in/laura-douglas-86658721a/' },
];

const year = new Date().getFullYear();
---
<footer class="site-footer wrap">
  <div class="footer-top">
    <a class="logo" href={url('/')}>
    
        <img src={url('/icons/xtxlogo_white.svg')} alt="txttravels logo" />
      
    </a>
    <p class="footer-blurb">Curating wonders off the beaten path since 2012.</p>
  </div>

  <hr class="footer-rule" />

  <div class="footer-bottom">
    <a
    class="footer-credit"
    href="https://bitcrafttech.com/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Made with coffee by Bitcraft Tech"
  >
  
    
    Made with <span aria-hidden="true">☕</span> by 
    <img src={url('/icons/bitcraft-clover.png')} alt="Bitcraft" width="20" height="20" />
    Bitcraft Tech
  </a>
    <p class="footer-legal">© {year} XTX Travels. All rights reserved.</p>
    <ul class="socials">
      {socials.map((social) => (
        <li>
          <a href={social.href} rel="noopener noreferrer" target="_blank">
            <img src={social.icon} alt={social.label} width="18" height="18" />
          </a>
        </li>
      ))}
    </ul>
    
  </div>

  
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 48px;
    background: var(--ink);
  }

  .footer-top,
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    background: var(--purple-light);
    border-radius: var(--radius);
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 18px;
    color: var(--white);
    line-height: normal;
  }

  .footer-blurb {
    font-size: 14px;
    color: var(--purple-light);
    line-height: normal;
  }

  .footer-rule {
    width: 100%;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px solid rgba(201, 160, 220, 0.25);
  }

  .footer-legal {
    font-size: 12px;
    color: var(--muted);
    line-height: normal;
  }

  .socials {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .socials a {
    display: block;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .socials a:hover { opacity: 1; }

  .footer-credit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    align-self: center;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    opacity: 0.8;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .footer-credit img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  .footer-credit:hover {
    color: var(--white);
    opacity: 1;
  }
</style>
