---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url.js';

const stats = [
  { value: '84', label: 'Countries Visited' },
  { value: '120+', label: 'Trips Successfully Led' },
  { value: '12', label: 'Years of Experience' },
];
---
<BaseLayout
  title="About — Offbeat Voyages"
  description="Meet Sarah Lin, founder of Offbeat Voyages, and the thinking behind small, deeply planned expeditions."
  active="About"
>
  <section class="about-columns wrap">
    <div class="about-story">
      <div class="story-text">
        <p class="eyebrow">The Explorer's Mindset</p>
        <h1>Meet Your Guide</h1>
        <p class="lede">
          I'm Sarah Lin, founder of Offbeat Voyages. Over a decade ago, I left a conventional desk
          job to seek out parts of the world that feel raw, complex, and unscripted. My mission is
          to show that modern luxury isn't about golden faucets — it's about absolute silence on a
          Carpathian ridge, a storm coming in off the Atlantic, or breaking bread with a family in
          a Mani tower house.
        </p>
        <p class="lede">
          We plan deep, design meticulously, and stay extremely small. When you travel with us, you
          are not a consumer of sights; you are a respectful guest of local cultures.
        </p>
      </div>

      <dl class="stats-deck">
        {stats.map((stat) => (
          <div class="stat-card card">
            <dt class="stat-value">{stat.value}</dt>
            <dd class="stat-label">{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="about-photo">
      <img src={url('/images/site/7c9258ff839693aabe5367b4d1acf649.png')} alt="Sarah Lin, founder of Offbeat Voyages" width="896" height="1152" />
    </div>
  </section>
</BaseLayout>

<style>
  .about-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 480px;
    gap: 80px;
    align-items: center;
    padding-block: 96px;
  }

  .about-story {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .story-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .story-text h1 { font-size: clamp(34px, 5vw, 48px); }

  .stats-deck {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border-radius: var(--radius-md);
    box-shadow: none;
  }
  .stat-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 36px;
    color: var(--purple);
    line-height: normal;
  }
  .stat-label {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    line-height: normal;
  }

  .about-photo {
    height: 580px;
    border-radius: 24px;
    overflow: clip;
  }
  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1100px) {
    .about-columns {
      grid-template-columns: 1fr;
      gap: 48px;
      padding-block: 64px;
    }
    .about-photo { height: 420px; order: -1; }
  }

  @media (max-width: 620px) {
    .stats-deck { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
