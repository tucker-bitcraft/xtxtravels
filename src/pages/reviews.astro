---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url.js';

const reviews = [
  {
    quote:
      'My week in the Carpathians was life-altering. Standing on a ridge at dusk with nothing but wind and the odd shepherd bell is something I will never forget. Sarah handles logistics perfectly.',
    name: 'Marcus Thorne',
    trip: 'Transylvania After Dark',
  },
  {
    quote:
      'The Mani was always on my list but seemed too hard to plan properly. XTX Travels simplified everything while keeping the trip adventurous, safe, and deeply respectful of the people who live there.',
    name: 'Clara Henderson',
    trip: "Mani's Tower Houses & Spinalonga",
  },
  {
    quote:
      'The Saxon villages felt like travelling back in time. Deep quiet, warm local families, and no crowds anywhere. Truly curated with immense love and care.',
    name: 'Rajesh Kapoor',
    trip: 'Saxon Villages & Salt Mines',
  },
  {
    quote:
      'Our guide in Clare had genuine relationships with everyone we met along the coast. We felt like family guests, not clients. Worth every single cent and more.',
    name: 'Helen Dubois',
    trip: 'Ghosts of the West Coast',
  },
];
---
<BaseLayout
  title="Reviews — XTX Travels"
  description="What travellers say after returning from an XTX Travels expedition."
  active="Reviews"
>
  <section class="reviews-content wrap">
    <div class="reviews-header">
      <p class="eyebrow">Client Stories</p>
      <h1>What Travelers Say</h1>
      <p class="lede">
        Hear from our community of curious minds and intrepid wanderers who have embarked on these
        wild journeys.
      </p>
    </div>

    <div class="reviews-grid">
      {reviews.map((review) => (
        <figure class="review-card">
          <div class="stars" role="img" aria-label="Rated 5 out of 5">
            {Array.from({ length: 5 }).map(() => (
              <img src={url('/icons/star.svg')} alt="" width="16" height="16" />
            ))}
          </div>
          <blockquote class="quote">"{review.quote}"</blockquote>
          <figcaption class="reviewer">
            <span class="reviewer-name">{review.name}</span>
            <span class="reviewer-trip">{review.trip}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .reviews-content {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: 80px;
  }

  .reviews-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 720px;
  }
  .reviews-header h1 { font-size: clamp(30px, 4.2vw, 40px); }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .review-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 32px;
    background: var(--white);
    border: 1px solid var(--purple);
    border-left-width: 4px;
    border-radius: var(--radius-lg);
    filter: drop-shadow(0 8px 8px rgba(30, 18, 44, 0.02));
  }

  .stars {
    display: flex;
    gap: 4px;
  }

  .quote {
    margin: 0;
    font-size: 16px;
    font-style: italic;
    line-height: 1.6;
    color: var(--ink);
  }

  .reviewer {
    display: flex;
    flex-direction: column;
    gap: 4px;
    line-height: normal;
  }
  .reviewer-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    color: var(--purple);
  }
  .reviewer-trip {
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .reviews-grid { grid-template-columns: 1fr; }
    .reviews-content { padding-block: 56px; gap: 36px; }
  }
</style>
